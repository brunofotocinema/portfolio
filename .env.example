# Firebase Authentication (client config — safe to expose, used in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# GitHub commit API (server-only — NEVER expose to the client)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=main

# TMDB (server-only) — busca a ficha técnica dos filmes a partir do link do IMDb.
# Aceita a "API key" (v3) ou o "API Read Access Token" (v4, começa com eyJ).
TMDB_API_KEY=
